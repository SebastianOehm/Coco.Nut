<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Allows building Windows-specific code paths from Linux/macOS CI runners. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>NUT Dot Net project</Company>
    <Product>Coco.Nut</Product>
    <Copyright>Copyright (C) 2019-2021 Gawindx (Decaux Nicolas), 2022+ NUT Dot Net project</Copyright>
    <Version>0.1.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en;de-DE;fr-FR;ru-RU;uk-UA;zh-CN;zh-TW</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
